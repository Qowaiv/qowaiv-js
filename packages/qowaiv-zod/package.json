{
  "name": "@qowaiv/qowaiv-zod",
  "description": "Zod integration for @qowaiv/qowaiv",
  "type": "module",
  "version": "0.1.0",
  "keywords": [
    "typescript",
    "types",
    "qowaiv",
    "svo",
    "zod"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "format": "prettier ./src --write",
    "format:check": "prettier ./src --check"
  },
  "dependencies": {
    "@qowaiv/qowaiv": "^0.0.5"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qowaiv/qowaiv-js.git"
  },
  "author": "Qowaiv Community",
  "license": "MIT"
}
