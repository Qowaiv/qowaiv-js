{
  "name": "@qowaiv/qowaiv",
  "description": "Qowaiv implements common, universal domain objects. These types form the base of your domain model.",
  "type": "module",
  "version": "0.0.3",
  "keywords": [
    "typescript",
    "types",
    "qowaiv",
    "svo"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint ./src",
    "test": "vitest run",
    "lint:fix": "eslint ./src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^10.8.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qowaiv/qowaiv-js.git"
  },
  "author": "Qowaiv Community",
  "license": "MIT"
}
