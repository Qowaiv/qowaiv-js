{
  "name": "@qowaiv/qowaiv",
  "description": "Qowaiv implements common, universal domain objects. These types form the base of your domain model.",
  "type": "module",
  "version": "0.1.0",
  "keywords": [
    "typescript",
    "types",
    "qowaiv",
    "svo"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint ./src",
    "test": "vitest run",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier ./src --write",
    "format:check": "prettier ./src --check"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qowaiv/qowaiv-js.git"
  },
  "author": "Qowaiv Community",
  "license": "MIT"
}
